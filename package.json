{
  "name": "ribo-ui",
  "version": "2.3.0",
  "description": "Base compartida de la casa RIBO: sistema de diseño, helpers comunes y lit-html.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./ribo.css": "./src/ribo.css",
    "./tokens.css": "./src/css/tokens.css",
    "./base.css": "./src/css/base.css",
    "./package.json": "./package.json",
    "./eslint": "./config/eslint.js",
    "./prettier": "./config/prettier.json"
  },
  "bin": {
    "ribo-check-escape": "bin/check-escape.mjs"
  },
  "files": [
    "src",
    "config",
    "bin",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "iconos": "node scripts/generar-iconos.mjs",
    "demo": "vite demo --port 5174",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lit-html": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "lucide": "1.52.0",
    "prettier": "^3.9.9",
    "rolldown": "^1.2.5",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "@eslint/js": ">=9",
    "eslint": ">=9",
    "globals": ">=15",
    "prettier": ">=3"
  },
  "peerDependenciesMeta": {
    "@eslint/js": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "globals": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "prettier": "./config/prettier.json"
}
